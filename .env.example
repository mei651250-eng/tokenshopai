# TokenHub 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== 必须配置 ====================
# JWT 签名密钥（必须设置，至少 32 字符）
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# KeyVault 主加密密钥（必须设置，至少 32 字节）
KEYVAULT_MASTER_KEY=your-master-key-at-least-32-bytes!

# 数据库密码
DB_PASSWORD=tokenhub_secret

# Redis 密码（生产环境必须设置）
REDIS_PASSWORD=

# ==================== 可选配置 ====================
# 超级管理员邮箱
ADMIN_EMAIL=admin@tokenhub.com

# 超级管理员密码（生产环境必须设置强密码）
ADMIN_PASSWORD=

# WebAuthn Origin（生产环境设置为实际域名）
WEBAUTHN_ORIGIN=https://tokenshopai.com

# 配置文件路径（默认 configs/config.yaml）
CONFIG_PATH=configs/config.yaml
