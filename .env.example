# ==================== TokenHub 环境变量配置 ====================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ---------- 服务器配置 ----------
SERVER_PORT=8080
SERVER_MODE=debug  # debug | release

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=tokenhub
DB_PASSWORD=changeme_strong_password
DB_NAME=tokenhub
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
JWT_SECRET=changeme_random_secret_at_least_32_chars
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=168h

# ---------- 超级管理员 ----------
ADMIN_EMAIL=admin@tokenhub.com
ADMIN_PASSWORD=changeme_admin_password
ADMIN_TENANT_ID=

# ---------- 支付宝 ----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.tokenhub.com/auth/callback/alipay
ALIPAY_SANDBOX=true

# ---------- 微信支付 ----------
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=
WECHAT_NOTIFY_URL=https://api.tokenhub.com/auth/callback/wechat
WECHAT_SANDBOX=true

# ---------- PayPal ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_NOTIFY_URL=https://api.tokenhub.com/auth/callback/paypal

# ---------- Stripe ----------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_NOTIFY_URL=https://api.tokenhub.com/auth/callback/stripe

# ---------- 短信验证码 ----------
SMS_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=TokenHub
SMS_TEMPLATE_CODE=

# ---------- 邮件验证码 ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.tokenhub.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@tokenhub.com

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- 上传 ----------
UPLOAD_DIR=./uploads

# ---------- 监控 ----------
MONITOR_ALERT_WEBHOOK=
